# East Campus Configuration
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=student_record_system_east

# Admin User Configuration
ADMIN_USERNAME=east_admin
ADMIN_PASSWORD=eastadmin123
ADMIN_EMAIL=eastadmin@school.edu

# Site Configuration
DEFAULT_SITE_ID=2
SITE_NAME=East Campus
SITE_CODE=EAST

# Application Configuration
APP_NAME=Student Record System - East Campus
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/east_campus

# Security
SESSION_LIFETIME=120
CSRF_TOKEN=true

# Academic Settings
DEFAULT_ACADEMIC_YEAR=2024-2025
PASSING_SCORE=50
MAX_STUDENTS_PER_CLASS=40

# Distributed System Settings
ENABLE_DISTRIBUTED=true
DEFAULT_SITE_ID=2
SYNC_ENABLED=true

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Maintenance
MAINTENANCE_MODE=false
