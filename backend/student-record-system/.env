DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=student_record_system

APP_NAME=Student Record System
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/advance/student-record-system
ALLOWED_ORIGINS=http://localhost

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@school.edu

STUDENT_LOGIN_DOMAIN=school.local
TEACHER_LOGIN_DOMAIN=school.local

SESSION_LIFETIME=120
CSRF_TOKEN=true

MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

LOG_LEVEL=error

ENABLE_DISTRIBUTED=false
DEFAULT_SITE_ID=1
SYNC_ENABLED=false

DEFAULT_ACADEMIC_YEAR=2024-2025
PASSING_SCORE=50
MAX_STUDENTS_PER_CLASS=40

FORCE_HTTPS=false
MAINTENANCE_MODE=false

API_RATE_LIMIT=1000
API_TIMEOUT=30
