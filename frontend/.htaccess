# Deny access to hidden files and directories (.git, .env, .tmp_sessions)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny access to SQL files
<FilesMatch "\.(sql|sqlite|db)$">
    Require all denied
</FilesMatch>

# Deny access to batch/shell scripts
<FilesMatch "\.(bat|sh|cmd)$">
    Require all denied
</FilesMatch>

# Deny access to zip archives
<FilesMatch "\.zip$">
    Require all denied
</FilesMatch>

# Default charset
AddDefaultCharset UTF-8

# Disable directory listing
Options -Indexes
